{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Golem type scale. One family (Inter), two weights in general use (400 Regular, 500 Medium) plus one 600 cut that a component really uses: headings/headlineSecondaryBold on CO Content Card / v6.2 Promo. Figma stores letterSpacing as a percentage of the font size; the px value is given for implementations that need it. Headings are the 'headings/*' variable group, everything else is 'content/*'.",
  "$extensions": {
    "golem": {
      "source": "Figma variables read from CO Text Heading, CO Text Paragraph, CO Button, CO Item Display, CO Content Card and CO Product nodes 2026-08-12; px letter-spacing cross-checked against the Golem showcase snapshot 2026-08-11 and against the savings screens 2026-08-12",
      "weightNames": {
        "400": "Regular",
        "500": "Medium",
        "600": "Bolder"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "sans-serif"
      ]
    },
    "headings": {
      "titlePrimary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "42px",
          "lineHeight": "52px",
          "fontWeight": 500,
          "letterSpacing": "-1.26px"
        },
        "$description": "Hero heading. CO Text Heading / v4.0 Hero. letterSpacing -3%."
      },
      "titleSecondary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "32px",
          "lineHeight": "44px",
          "fontWeight": 500,
          "letterSpacing": "-0.96px"
        },
        "$description": "letterSpacing -3%. Used by product detail balances."
      },
      "titleTertiary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "28px",
          "lineHeight": "36px",
          "fontWeight": 500,
          "letterSpacing": "-0.7px"
        },
        "$description": "Page heading. CO Text Heading / v4.0 Page. letterSpacing -2.5%."
      },
      "titleQuaternary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "24px",
          "lineHeight": "32px",
          "fontWeight": 500,
          "letterSpacing": "-0.6px"
        },
        "$description": "Observed in the showcase snapshot only; no Figma node in this pass used it."
      },
      "headlinePrimary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "20px",
          "lineHeight": "28px",
          "fontWeight": 500,
          "letterSpacing": "-0.4px"
        },
        "$description": "Modal title. letterSpacing -2%."
      },
      "headlineSecondary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "18px",
          "lineHeight": "24px",
          "fontWeight": 500,
          "letterSpacing": "-0.36px"
        },
        "$description": "Section heading. CO Text Heading / v4.0 Section. letterSpacing -2%."
      },
      "headlineSecondaryBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "18px",
          "lineHeight": "24px",
          "fontWeight": 600,
          "letterSpacing": "-0.36px"
        },
        "$description": "Promo card title. CO Content Card / v6.2 Promo. letterSpacing -2%. The only 600 cut a published component uses."
      }
    },
    "content": {
      "bodyPrimary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 400,
          "letterSpacing": "-0.24px"
        },
        "$description": "Default paragraph. letterSpacing -1.5%."
      },
      "bodyPrimaryBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 500,
          "letterSpacing": "-0.24px"
        }
      },
      "bodySecondary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 400,
          "letterSpacing": "-0.14px"
        },
        "$description": "Dense lists and table cells. letterSpacing -1%."
      },
      "bodySecondaryBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 500,
          "letterSpacing": "-0.14px"
        },
        "$description": "List item label — the most used style in the system."
      },
      "captionPrimary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "12px",
          "lineHeight": "16px",
          "fontWeight": 400,
          "letterSpacing": "-0.06px"
        },
        "$description": "letterSpacing -0.5%."
      },
      "captionPrimaryBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "12px",
          "lineHeight": "16px",
          "fontWeight": 500,
          "letterSpacing": "-0.06px"
        }
      },
      "captionSecondary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "10px",
          "lineHeight": "16px",
          "fontWeight": 400,
          "letterSpacing": "0"
        },
        "$description": "Smallest type in the system. Never use for anything a user must act on."
      },
      "captionSecondaryBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "10px",
          "lineHeight": "16px",
          "fontWeight": 500,
          "letterSpacing": "0"
        },
        "$description": "Badge and tag label."
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 500,
          "letterSpacing": "-0.24px"
        },
        "$description": "Button label. Same metrics as bodyPrimaryBold but a separate token — do not substitute."
      }
    }
  }
}
